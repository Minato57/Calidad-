# Copia este archivo como .env y completa los valores. El .env real NO se versiona.

PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=citasmedicassangenaro
JWT_SECRET=

# ---------- Mercado Pago (Checkout Pro) ----------
# Sin MP_ACCESS_TOKEN y fuera de producción, los pagos funcionan en modo SIMULADO.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
TARIFA_CONSULTA_PEN=20
PAGOS_HABILITADOS=true
FRONTEND_URL=http://localhost:5173
# BACKEND_PUBLIC_URL=            # URL pública del backend (webhook de Mercado Pago y enlace de recetas)
NODE_ENV=development

# ---------- SIS (Seguro Integral de Salud) ----------
#   SEGURO_PROVIDER=portal    -> consulta real al portal oficial (el usuario resuelve el Captcha)
#   SEGURO_PROVIDER=simulado  -> MODO DEMO sin portal (se ignora si NODE_ENV=production);
#                                tienen SIS los DNI listados en SIS_SIMULADO_ASEGURADOS
SEGURO_PROVIDER=portal
SIS_CONSULTA_URL=https://cel.sis.gob.pe/SisConsultaEnLinea
SIS_VIGENCIA_DIAS=90
SIS_SIMULADO_ASEGURADOS=
# SIS_CA_FILE=                   # opcional: ruta a otro certificado intermedio (por defecto certs/sis-intermedio.pem)
